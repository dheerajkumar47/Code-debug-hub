# Copy to .env and fill in. Never commit .env.

# --- Freelancer.com (official API, OAuth token with bidding scope) ---
FREELANCER_OAUTH_TOKEN=
# Sandbox for safe testing: https://www.freelancer-sandbox.com/api
FREELANCER_API_URL=https://www.freelancer.com/api
FREELANCER_SITE_URL=https://www.freelancer.com

# --- AI writer: gemini | openai | anthropic | none (none = template drafts) ---
LLM_PROVIDER=gemini
LLM_API_KEY=
# blank = provider default (gemini-2.5-flash / gpt-4.1-mini / claude-sonnet-5-5)
LLM_MODEL=
# optional OpenAI-compatible endpoint (Groq, OpenRouter) with LLM_PROVIDER=openai
LLM_BASE_URL=
# true = AI also judges fit (more accurate, costs more calls)
LLM_SCORE_ENABLED=false

# --- Where you approve bids: whatsapp,web,console ---
NOTIFY_CHANNELS=web,console

# --- WhatsApp Cloud API (Meta official) — see docs/04-setup.md ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-any-long-random-string
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
# optional approved template for when the 24h window is closed
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
# your number, international format, digits only
OWNER_WHATSAPP=923001234567

# --- Web dashboard (works in any phone browser, no VPN) ---
DASHBOARD_USER=owner
DASHBOARD_PASSWORD=
# e.g. https://bidsmith.example.com (used for links in WhatsApp)
PUBLIC_BASE_URL=

# --- Behaviour ---
POLL_INTERVAL_SECONDS=180
# 70 = only strong matches (saves your limited bids). Lower to 60 for more cards.
SCORE_THRESHOLD=70
# keep false: you approve every bid
AUTO_SUBMIT=false
AUTO_SUBMIT_MIN_SCORE=85
MAX_BIDS_PER_DAY=5
MIN_SECONDS_BETWEEN_BIDS=90
MILESTONE_PERCENTAGE=50

DB_PATH=data/bidsmith.db
PROFILE_PATH=profile/owner_profile.yaml
