{
  "name": "code-debug-hub",
  "version": "1.0.0",
  "description": "🤖 Smart debugging platform that helps developers store issues, find solutions, and get AI-powered suggestions using GPT-4. Built with Next.js &amp; PostgreSQL.",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "type-check": "tsc --noEmit",
    "setup": "npm run db:generate && npm run db:push && npm run db:seed"
  },
